{
  "name": "genshinexe",
  "version": "0.1.3",
  "private": true,
  "author": "GenshinWallpaper",
  "description": "Windows 动态壁纸 · 魈与璃月灯火",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/install-electron.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "start": "npm run prepare:web && electron .",
    "start:ready": "electron .",
    "dist:installer": "node scripts/build-installer.mjs",
    "test": "node --test tests/*.test.cjs",
    "source:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "sharp": "0.35.5"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.genshinexe.wallpaper",
    "productName": "GenshinWallpaper",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!electron/wallpaper-host.ps1",
      "!electron/wallpaper-renderer.mjs",
      "!electron/wallpaper.html",
      "!electron/wallpaper.css"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "wallpaper"
      },
      {
        "from": "electron/wallpaper-host.ps1",
        "to": "wallpaper-host.ps1"
      },
      {
        "from": "vendor/licenses/THREE-LICENSE.txt",
        "to": "licenses/THREE-LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "licenses/THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "icon": "electron/assets/genshinexe.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "releaseInfo": {
        "releaseName": "GenshinWallpaper v0.1.3",
        "releaseNotesFile": "docs/releases/0.1.3.md"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GenshinWallpaper",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "artifactName": "GenshinWallpaper-Setup-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "likefadian",
      "repo": "genshin-live-wallpaper",
      "private": false,
      "releaseType": "release"
    }
  }
}
